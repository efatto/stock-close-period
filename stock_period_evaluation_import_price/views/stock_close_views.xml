<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_period_evaluation_form" model="ir.ui.view">
        <field name="name">stock.close.period.form</field>
        <field name="model">stock.close.period</field>
        <field
            name="inherit_id"
            ref="stock_period_evaluation.stock_period_evaluation_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='no_recompute_lines']" position="after">
                <label for="import_file" />
                <div>
                    <div>
                        <field name="import_file" filename="import_file_name" />
                        <field name="import_file_name" invisible="1" />
                    </div>
                    <div>
                        <button
                            type="object"
                            name="action_import_price_file"
                            icon="fa-upload"
                            string="Import prices from file"
                            title="Update prices from uploaded file"
                            invisible="not import_file"
                        />
                    </div>
                </div>
            </xpath>
            <xpath
                expr="//form/header/button[@name='action_done']"
                position="attributes"
            >
                <attribute
                    name="invisible"
                >state != 'confirm' or (not import_file and not production_ok)</attribute>
            </xpath>
            <xpath
                expr="//form/header/button[@name='action_recalculate_purchase']"
                position="attributes"
            >
                <attribute name="invisible">import_file</attribute>
            </xpath>
        </field>
    </record>
</odoo>
