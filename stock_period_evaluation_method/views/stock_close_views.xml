<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_period_evaluation_form" model="ir.ui.view">
        <field name="name">stock.close.period.form</field>
        <field name="model">stock.close.period</field>
        <field
            name="inherit_id"
            ref="stock_period_evaluation.stock_period_evaluation_form"
        />
        <field name="arch" type="xml">
            <field name="last_closed_id" position="attributes">
                <attribute
                    name="required"
                >force_evaluation_method in ('fifp', 'lifp')</attribute>
            </field>
        </field>
    </record>
</odoo>
