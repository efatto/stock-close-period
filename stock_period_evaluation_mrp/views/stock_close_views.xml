<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="stock_close_period_line_tree" model="ir.ui.view">
        <field name="name">stock.close.period.line.tree</field>
        <field name="model">stock.close.period.line</field>
        <field
            name="inherit_id"
            ref="stock_close_period.stock_close_period_line_tree"
        />
        <field name="arch" type="xml">
            <field name="amount_line" position="after">
                <button
                    name="action_recalculate_production"
                    states="confirm"
                    help="Compute Production"
                    icon="fa-industry"
                    type="object"
                    groups="stock_close_period.group_stock_close_period_manager"
                />
            </field>
        </field>
    </record>

    <record id="stock_close_period_tree_inherit" model="ir.ui.view">
        <field name="name">stock.close.period.tree.inherit</field>
        <field name="model">stock.close.period</field>
        <field name="inherit_id" ref="stock_close_period.stock_close_period_tree" />
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='state']" position="after">
                <field name="force_standard_price" />
            </xpath>
        </field>
    </record>

    <record id="stock_close_period_form_inherit" model="ir.ui.view">
        <field name="name">stock.close.period.form.inherit</field>
        <field name="model">stock.close.period</field>
        <field name="inherit_id" ref="stock_close_period.stock_close_period_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//form/header/button[@name='action_recalculate_purchase']"
                position="after"
            >
                <button
                    name="action_recalculate_production"
                    string="Compute Production"
                    type="object"
                    class="oe_highlight"
                    groups="stock_close_period.group_stock_close_period_manager"
                    attrs="{'invisible': ['|',('purchase_ok', '=', False),('state', 'not in', ['confirm'])]}"
                />
            </xpath>
            <xpath
                expr="//form/header/button[@name='action_done']"
                position="attributes"
            >
                <attribute
                    name="attrs"
                >{'invisible': ['|',('production_ok', '=', False),('state', 'not in', ['confirm'])]}</attribute>
            </xpath>
            <xpath expr="//field[@name='force_evaluation_method']" position="after">
                <field
                    name="force_standard_price"
                    attrs="{'invisible': [('purchase_ok', '=', False)]}"
                />
            </xpath>
            <xpath expr="//field[@name='purchase_ok']" position="after">
                <field name="production_ok" />
            </xpath>
            <xpath
                expr="//field[@name='force_evaluation_method']"
                position="attributes"
            >
                <attribute name="attrs">
                    {'readonly': ['|', ('purchase_ok', '=', True), ('production_ok', '=', True)]}
                </attribute>
            </xpath>
            <xpath
                expr="//field[@name='line_ids']/tree/button[@name='action_recalculate_purchase']"
                position="after"
            >
                <button
                    name="action_recalculate_production"
                    states="confirm"
                    help="Compute Production"
                    icon="fa-industry"
                    type="object"
                    groups="stock_close_period.group_stock_close_period_manager"
                />
            </xpath>
        </field>
    </record>

</odoo>
