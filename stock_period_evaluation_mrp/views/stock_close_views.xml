<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_period_evaluation_line_tree" model="ir.ui.view">
        <field name="name">stock.close.period.line.list</field>
        <field name="model">stock.close.period.line</field>
        <field
            name="inherit_id"
            ref="stock_period_evaluation.stock_period_evaluation_line_tree"
        />
        <field name="arch" type="xml">
            <field name="amount_line" position="after">
                <button
                    name="action_recalculate_production"
                    help="Compute Production"
                    title="Compute Production"
                    icon="fa-industry"
                    type="object"
                    groups="stock_period_evaluation.group_stock_period_evaluation_manager"
                    invisible="close_id.state != 'confirm'"
                />
            </field>
        </field>
    </record>

    <record id="stock_period_evaluation_tree_inherit" model="ir.ui.view">
        <field name="name">stock.close.period.list.inherit</field>
        <field name="model">stock.close.period</field>
        <field
            name="inherit_id"
            ref="stock_period_evaluation.stock_period_evaluation_tree"
        />
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='state']" position="after">
                <field name="force_standard_price" />
            </xpath>
        </field>
    </record>

    <record id="stock_period_evaluation_form_inherit" model="ir.ui.view">
        <field name="name">stock.close.period.form.inherit</field>
        <field name="model">stock.close.period</field>
        <field
            name="inherit_id"
            ref="stock_period_evaluation.stock_period_evaluation_form"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//form/header/button[@name='action_recalculate_purchase']"
                position="after"
            >
                <button
                    name="action_recalculate_production"
                    string="Compute Production"
                    type="object"
                    class="oe_highlight"
                    groups="stock_period_evaluation.group_stock_period_evaluation_manager"
                    invisible="not purchase_ok or state != 'confirm'"
                />
            </xpath>
            <xpath
                expr="//form/header/button[@name='action_done']"
                position="attributes"
            >
                <attribute
                    name="invisible"
                >not production_ok or state != 'confirm'</attribute>
            </xpath>
            <xpath expr="//field[@name='force_evaluation_method']" position="after">
                <field name="force_standard_price" invisible="not purchase_ok" />
            </xpath>
            <xpath expr="//field[@name='purchase_ok']" position="after">
                <field name="production_ok" />
            </xpath>
            <xpath
                expr="//field[@name='force_evaluation_method']"
                position="attributes"
            >
                <attribute name="readonly">purchase_ok or production_ok</attribute>
            </xpath>
            <xpath
                expr="//field[@name='line_ids']/list/field[@name='amount_line']"
                position="after"
            >
                <field name="close_id" column_invisible="True" />
                <button
                    name="action_recalculate_production"
                    help="Compute Production"
                    title="Compute Production"
                    icon="fa-industry"
                    type="object"
                    groups="stock_period_evaluation.group_stock_period_evaluation_manager"
                    invisible="close_id.state != 'confirm'"
                />
            </xpath>
        </field>
    </record>
</odoo>
