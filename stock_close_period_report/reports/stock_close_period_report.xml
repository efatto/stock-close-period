<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template id="report_product_print">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="title">Stock Close Product <t t-esc="o.name" /></t>
                <t t-call="stock_close_period_report.document_layout">
                    <div class="page">
                        <table style="width:100%; font-size: x-small;" cellspacing="0">
                            <thead>
                                <tr style="page-break-inside: avoid">
                                    <th class="left_with_line">Date</th>
                                    <th class="left_with_line">Transfer type</th>
                                    <th class="left_with_line">Origin</th>
                                    <th class="left_with_line">Destination</th>
                                    <th class="right_with_line">Amount</th>
                                    <th class="right_with_line">UoM</th>
                                    <th class="right_with_line">Quantity IN</th>
                                    <th class="right_with_line">Quantity OUT</th>
                                    <th class="right_with_line">Final Quantity</th>
                                </tr>
                            </thead>

                            <t t-set="product_value" t-value="0" />
                            <tbody>
                                <t t-foreach="o.line_ids" t-as="close_line">
                                    <tr
                                        style="page-break-inside: avoid; border:1px solid #fff;"
                                    >
                                        <td colspan="6"><strong><div
                                                    t-field="close_line.product_id.display_name"
                                                /></strong></td>
                                        <td
                                            class="right_with_line"
                                        >Evaluation Method<div
                                                style="page-break-inside: avoid"
                                                t-field="close_line.evaluation_method"
                                            /></td>
                                        <td class="right_with_line">Initial Value<div
                                                style="page-break-inside: avoid"
                                                t-field="close_line.inventory_amount"
                                            /></td>
                                        <td class="right_with_line">Initial Quantity<div
                                                style="page-break-inside: avoid"
                                                t-field="close_line.inventory_qty"
                                            /></td>
                                    </tr>
                                    <t t-set="in_qty" t-value="0.0" />
                                    <t t-set="out_qty" t-value="0.0" />
<!--                                    todo show initial values-->
                                    <t t-foreach="get_moves(close_line)" t-as="move">
                                        <t
                                            t-set="move_type"
                                            t-value="'in' if move.location_id.usage != 'internal' and move.location_dest_id.usage == 'internal' else 'out'"
                                        />
                                        <tr
                                            style="page-break-inside: avoid; border:1px solid #fff;"
                                        >
                                            <td class="left_with_line"><div
                                                    style="page-break-inside: avoid"
                                                    t-field="move.date"
                                                    t-options='{"widget": "date", "format": "dd/MM/Y"}'
                                                /></td>
                                            <td class="left_with_line"><div
                                                    style="page-break-inside: avoid"
                                                    t-esc="move_type.upper()"
                                                /></td>
                                            <td class="left_with_line"><div
                                                    style="page-break-inside: avoid"
                                                    t-field="move.location_id.name"
                                                /></td>
                                            <td class="left_with_line"><div
                                                    style="page-break-inside: avoid"
                                                    t-field="move.location_dest_id.name"
                                                /></td>
                                            <td class="right_with_line">
                                                <t t-if="move.purchase_line_id">
                                                    <div
                                                        style="page-break-inside: avoid"
                                                        t-field="move.purchase_line_id.price_subtotal"
                                                    />
                                                </t>
                                            </td>
                                            <td class="right_with_line"><div
                                                    style="page-break-inside: avoid"
                                                    t-field="move.product_uom.name"
                                                /></td>
                                            <td class="right_with_line">
                                                <t t-if="move_type == 'in'">
                                                    <t
                                                        t-set="in_qty"
                                                        t-value="in_qty + move.quantity_done"
                                                    />
                                                    <div
                                                        style="page-break-inside: avoid"
                                                        t-field="move.quantity_done"
                                                    />
                                                </t>
                                            </td>
                                            <td class="right_with_line">
                                                <t t-if="move_type == 'out'">
                                                    <t
                                                        t-set="out_qty"
                                                        t-value="out_qty + move.quantity_done"
                                                    />
                                                    <div
                                                        style="page-break-inside: avoid"
                                                        t-field="move.quantity_done"
                                                    />
                                                </t>
                                            </td>
                                            <td class="right_with_line">
                                                <div
                                                    style="page-break-inside: avoid"
                                                    t-esc="in_qty - out_qty"
                                                />
                                            </td>
                                        </tr>
                                    </t>
                                    <tr>
                                        <td class="left_with_line" colspan="5" />
                                        <td class="left_with_line"><strong
                                            >Totals</strong></td>
                                        <td class="right_with_line">
                                            <strong><span
                                                    t-esc="in_qty"
                                                    t-options='{"widget": "float", "decimal_precision": "Product Unit of Measure"}'
                                                /></strong>
                                        </td>
                                        <td class="right_with_line">
                                            <strong><span
                                                    t-esc="out_qty"
                                                    t-options='{"widget": "float", "decimal_precision": "Product Unit of Measure"}'
                                                /></strong>
                                        </td>
                                        <td class="right_with_line">
                                            <strong><span
                                                    t-esc="close_line.inventory_qty + close_line.product_qty"
                                                    t-options='{"widget": "float", "decimal_precision": "Product Unit of Measure"}'
                                                /></strong>
                                        </td>
                                    </tr>
                                    <tr
                                        style="page-break-inside: avoid; border:1px solid #fff;"
                                    >
                                        <td colspan="7"><strong><div
                                                    t-field="close_line.product_id.display_name"
                                                /></strong></td>
                                        <td class="right_with_line"><strong
                                            >Final Evaluation<div
                                                    t-esc="close_line.inventory_amount + close_line.amount_line"
                                                    t-options='{"widget": "float", "decimal_precision": "Account"}'
                                                /></strong></td>
                                        <td class="right_with_line"><strong
                                            >Final Quantity<div
                                                    style="page-break-inside: avoid"
                                                    t-esc="close_line.inventory_qty + close_line.product_qty"
                                                    t-options='{"widget": "float", "decimal_precision": "Product Unit of Measure"}'
                                                /></strong></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
