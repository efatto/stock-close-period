<!--                                                <strong><span t-esc="ctgs[ctg]['value_residual']" t-options='{"widget": "float", "precision": "Account"}'/></strong>-->
<!--                                            </td>-->
<!--                                        </tr>-->
<!--                                    </t>-->
<!--                                </t>-->
<!--                        </table>-->
                        <br />
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="report_stock_close_product_landscape" model="report.paperformat">
        <field name="name">Stock close product landscape</field>
        <field name="default" eval="True" />
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">25</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">20</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_stock_close_product_report" model="ir.actions.report">
        <field name="name">Stock Close Product Report</field>
        <field name="model">stock.close.period</field>
        <field
            name="binding_model_id"
            ref="stock_close_period.model_stock_close_period"
        />
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_close_period_report.report_product_print</field>
        <field name="report_file">stock_close_period_report.report_product_print</field>
        <field
            name="print_report_name"
        >'Stock Close Product %s' % object.name.replace('/','')</field>
        <field name="paperformat_id" ref="report_stock_close_product_landscape" />
    </record>
</odoo>
