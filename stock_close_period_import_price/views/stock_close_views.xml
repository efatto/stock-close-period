<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="stock_close_period_form" model="ir.ui.view">
        <field name="name">stock.close.period.form</field>
        <field name="model">stock.close.period</field>
        <field name="inherit_id" ref="stock_close_period.stock_close_period_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main_group']" position="inside">
                <group>
                    <label for="import_file" />
                    <div class="o_row">
                        <field name="import_file" />
                        <button
                            type="object"
                            name="action_import_price_file"
                            class="btn-secondary"
                            icon="fa-file-import"
                            aria-label="Import price file"
                            title="Update prices from file"
                        />
                    </div>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
