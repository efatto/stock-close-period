<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="stock_close_period_form" model="ir.ui.view">
        <field name="name">stock.close.period.form</field>
        <field name="model">stock.close.period</field>
        <field name="inherit_id" ref="stock_close_period.stock_close_period_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main_group']/group[last()]" position="inside">
                <label for="import_file" />
                <div>
                    <div>
                        <field name="import_file" filename="import_file_name" />
                        <field name="import_file_name" invisible="1" />
                    </div>
                    <div>
                        <button
                            type="object"
                            name="action_import_price_file"
                            icon="fa-upload"
                            string="Import prices from file"
                            title="Update prices from uploaded file"
                            attrs="{'invisible': [('import_file', '=', False)]}"
                        />
                    </div>
                </div>
            </xpath>
            <xpath
                expr="//form/header/button[@name='action_done']"
                position="attributes"
            >
                <attribute
                    name="attrs"
                >{'invisible': [('import_file', '=', False)]}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
